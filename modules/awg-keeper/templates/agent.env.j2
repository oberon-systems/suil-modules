AWG_KEEPER_AWG_CONF_DIR={{ config.awg_conf_dir }}
AWG_KEEPER_IP_BIN={{ config.ip_bin }}

AWG_KEEPER_XRAY_BIN={{ config.xray_bin }}
AWG_KEEPER_XRAY_API={{ config.xray_api }}
AWG_KEEPER_XRAY_CONFIG={{ config.xray_config }}

AWG_KEEPER_COMMAND_TIMEOUT={{ config.command_timeout }}
AWG_KEEPER_LOG_LEVEL={{ config.log_level }}
AWG_KEEPER_DOCS={{ config.docs | string | lower }}
