# Managed by suil, module `repos`.
[Unit]
Description=Read-only HTTP front of the {{ name }} object store
Documentation=file://{{ config_file }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
# rclone keeps its cache under $HOME, and ProtectSystem=strict leaves nowhere
# else to write; CacheDirectory is the one path systemd opens for it.
Environment=HOME=%C/{{ unit }}
ExecStart={{ binary }} serve http --read-only --config {{ config_file }} --addr {{ listen }} --cache-dir %C/{{ unit }}{{ arguments }} {{ name }}:{{ bucket }}
Restart=always
RestartSec=5

CacheDirectory={{ unit }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
